/* TRAKKOUT — lightweight dark theme. Tweak here without touching code. */
QMainWindow, QWidget {
    background-color: #1e1e24;
    color: #e0e0e6;
    font-size: 13px;
}
QMenuBar {
    background-color: #26262e;
    color: #e0e0e6;
    padding: 2px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #3a3a48;
}
QMenu {
    background-color: #26262e;
    color: #e0e0e6;
    border: 1px solid #3a3a48;
}
QGroupBox {
    border: 1px solid #3a3a48;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 6px;
    font-weight: bold;
    color: #b8c7ff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
}
QLabel { color: #e0e0e6; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QDateTimeEdit {
    background-color: #2a2a33;
    border: 1px solid #3f3f4d;
    border-radius: 4px;
    padding: 4px;
    color: #f0f0f5;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus { border: 1px solid #6c8cff; }
QLineEdit::placeholder { color: #8a8a96; }
QPushButton {
    background-color: #34343f;
    border: 1px solid #4a4a5a;
    border-radius: 5px;
    padding: 6px 12px;
    color: #f0f0f5;
}
QPushButton:hover { background-color: #40404e; }
QPushButton:pressed { background-color: #2c2c36; }
QPushButton:disabled { color: #77777f; background-color: #28282f; }
QPushButton#accentButton {
    background-color: #2e6b46;
    border: 1px solid #3f9a63;
    font-weight: bold;
}
QPushButton#accentButton:hover { background-color: #368052; }
QPushButton#accentButton:disabled { background-color: #28282f; color: #77777f; }
QProgressBar {
    background-color: #2a2a33;
    border: 1px solid #3f3f4d;
    border-radius: 5px;
    text-align: center;
    min-height: 16px;
    color: #f0f0f5;
}
QProgressBar::chunk {
    background-color: #3f9a63;
    border-radius: 4px;
}
QTableWidget {
    background-color: #232329;
    alternate-background-color: #282830;
    gridline-color: #3a3a48;
    color: #e0e0e6;
}
QHeaderView::section {
    background-color: #2c2c36;
    color: #b8c7ff;
    border: none;
    padding: 5px;
    font-weight: bold;
}
QTabWidget::pane { background-color: #1e1e24; }
QStatusBar { background-color: #26262e; color: #b0b0ba; }
/* Sidebar de navegación */
QFrame#sidebar {
    background-color: #232329;
    border: 1px solid #3a3a48;
    border-radius: 8px;
}
QPushButton#navButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 8px 2px;
    color: #b0b0ba;
}
QPushButton#navButton:hover { background-color: #2e2e38; color: #f0f0f5; }
QPushButton#navButton:checked {
    background-color: #2e3d33;
    border: 1px solid #3f9a63;
    color: #7fe0a0;
    font-weight: bold;
}
QLabel#accountDot { color: #77777f; font-size: 16px; }
QLabel#accountDot[connected="true"] { color: #3f9a63; }
QLabel#accountName { color: #b0b0ba; font-size: 11px; }
/* Secciones plegables */
QFrame#section {
    background-color: #232329;
    border: 1px solid #3a3a48;
    border-radius: 8px;
}
QPushButton#sectionHeader {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 7px 8px;
    font-weight: bold;
    color: #b8c7ff;
    text-align: left;
}
QPushButton#sectionHeader:hover { background-color: #2b2b35; }
QFrame#sectionContent { background-color: transparent; border: none; }
/* Barra inferior de generación */
QFrame#generateBar {
    background-color: #232329;
    border: 1px solid #3a3a48;
    border-radius: 8px;
    padding: 6px;
}
QCheckBox, QRadioButton { color: #e0e0e6; }
QToolTip {
    background-color: #2c2c36;
    color: #f0f0f5;
    border: 1px solid #4a4a5a;
}
